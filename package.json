{
  "name": "readbot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A little robot that reads to you — audio-reactive SVG narrator, deployed on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}

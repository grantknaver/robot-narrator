{
  "name": "robot-narrator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/robot-narrator/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/robot-narrator",
        "index": "apps/robot-narrator/src/index.html",
        "main": "apps/robot-narrator/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/robot-narrator/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/robot-narrator/public"
          },
          "apps/robot-narrator/src/assets"
        ],
        "styles": [
          "apps/robot-narrator/src/styles.scss",
          "node_modules/primeflex/primeflex.css"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs", "apps/robot-narrator/src/styles"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "550kb",
              "maximumError": "6501mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "optimization": {
            "scripts": true,
            "styles": { "minify": true, "inlineCritical": true },
            "fonts": { "inline": true }
          },
          "buildOptimizer": true,
          "aot": true,
          "vendorChunk": false,
          "namedChunks": false,
          "extractLicenses": true,
          "sourceMap": false,
          "outputHashing": "all",
          "subresourceIntegrity": true,
          "localize": false
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "robot-narrator:build:production"
        },
        "development": {
          "buildTarget": "robot-narrator:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "robot-narrator:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/robot-narrator/jest.config.ts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "robot-narrator:build",
        "port": 4200,
        "spa": true
      }
    }
  }
}
